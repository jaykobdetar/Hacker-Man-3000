# Apache configuration for Hacker Experience Legacy (also used by the Docker image).
# If you use nginx, see docs/nginx.conf.example for the equivalent rules.

Options -Indexes -MultiViews
DirectoryIndex index.php index.html
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Code, data and tooling that must never be served directly.
    RewriteRule ^(classes|cron|cron2|python|scripts|template|info|json|locale|vendor|mail_templates|wiki|backups|docker|docs|tests)(/|$) - [R=404,L]
    # Dotfiles (.env, .git, .htaccess) and non-web files.
    RewriteRule (^|/)\. - [R=404,L]
    RewriteRule \.(sql|sql\.gz|po|mo|py|sh|dia|md|lock|ini|log|example|yml|yaml)$ - [R=404,L,NC]
    RewriteRule ^(composer\.json|crontab|Dockerfile|LICENSE)$ - [R=404,L]
    # Uploaded images are data, never code.
    RewriteRule ^images/.*\.(php|phtml|phar|pht|php\d)$ - [R=404,L,NC]

    # Pages are linked without the .php extension (e.g. /software?id=1).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# PHP pages send their own security headers (bootstrap.php); these cover static files.
<IfModule mod_headers.c>
    <FilesMatch "\.(?!php$)[^.]+$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Referrer-Policy "same-origin"
    </FilesMatch>
</IfModule>
