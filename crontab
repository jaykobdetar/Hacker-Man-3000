# Scheduled jobs for Hacker Experience Legacy.
#
# Install with `crontab crontab` as the user that runs the game (not root), after replacing
# /opt/hackerexperience with the path of this repository. The Docker setup runs the same jobs
# in the `cron` service (see docker/cron/entrypoint.sh).
#
# All jobs read their configuration from /opt/hackerexperience/.env.
# 2019: The rest of the scripts are needed for smooth operations of the game.

GAME=/opt/hackerexperience
LOG=/var/log/hackerexperience/cron.log
SHELL=/bin/sh

# Stats and rankings (every hour)
00 * * * *              python3 $GAME/cron2/updateCurStats.py              >> $LOG 2>&1
00 * * * *              python3 $GAME/cron2/updateRanking.py               >> $LOG 2>&1
00 * * * *              python3 $GAME/python/rank_generator.py             >> $LOG 2>&1

05,20,35,50 * * * *     python3 $GAME/cron2/removeExpiredLogins.py         >> $LOG 2>&1
05,15,25,35,45,55 * * * * php $GAME/cron/defcon2.php                       >> $LOG 2>&1
05,15,25,35,45,55 * * * * php $GAME/cron/endWar2.php                       >> $LOG 2>&1
40 * * * *              python3 $GAME/cron2/removeExpiredHTMLPages.py      >> $LOG 2>&1
10 */3 * * *            python3 $GAME/cron2/antivirusNPC.py                >> $LOG 2>&1
*/15 * * * *            python3 $GAME/cron2/restoreNPC.py                  >> $LOG 2>&1
12 * * * *              python3 $GAME/python/query_counter.py 500          >> $LOG 2>&1
*/15 * * * *            php $GAME/cron/generateMissions.php                >> $LOG 2>&1
*/30 * * * *            php $GAME/cron/safenetUpdate.php                   >> $LOG 2>&1
* * * * *               php $GAME/cron/doomUpdater.php                     >> $LOG 2>&1
* * * * *               python3 $GAME/cron2/newRoundUpdater.py             >> $LOG 2>&1
09 * * * *              python3 $GAME/cron2/removeExpiredAccs.py           >> $LOG 2>&1
19 * * * *              python3 $GAME/cron2/removeExpiredNPC.py            >> $LOG 2>&1
10 * * * *              php $GAME/cron/updateServerStats.php               >> $LOG 2>&1
19,49 * * * *           python3 $GAME/python/badge_hunter.py               >> $LOG 2>&1
19 * * * *              python3 $GAME/python/badge_hunter_all.py           >> $LOG 2>&1
02 * * * *              python3 $GAME/cron2/removeDownNPC.py               >> $LOG 2>&1
*/5 * * * *             python3 $GAME/cron2/fbiUpdate.py                   >> $LOG 2>&1

# Database backup (recommended, not required)
29 * * * *              $GAME/scripts/backup.sh                            >> $LOG 2>&1
