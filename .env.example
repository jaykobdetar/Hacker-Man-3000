# Copy to .env and fill in. Never commit .env.
# Values can also be supplied as real environment variables (they take precedence).

# --- Application -------------------------------------------------------------
# Public base URL, used in emails (verification / password reset links).
APP_URL=http://localhost:8080
# Show PHP errors in the browser. Keep false in production.
APP_DEBUG=false
APP_TIMEZONE=UTC
# Secret used to sign "keep me logged in" cookies. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# --- Database (MariaDB 10.6+ recommended) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=game
DB_USER=he
DB_PASSWORD=
# Only used by docker compose to initialise the MariaDB container.
DB_ROOT_PASSWORD=
# Optional: connect through a unix socket instead of host/port.
# DB_SOCKET=/run/mysqld/mysqld.sock
DB_CHARSET=utf8mb4
# The game relies on MySQL's non-strict mode.
DB_SQL_MODE=NO_ENGINE_SUBSTITUTION

# --- Sessions / cookies -------------------------------------------------------
# Strict: the browser never sends the session cookie on requests from other sites,
# which blocks cross-site request forgery through links. Use Lax if you need players
# to stay logged in when following links from other websites.
SESSION_SAMESITE=Strict
# Defaults to true when the request came over HTTPS.
# SESSION_SECURE_COOKIE=true
# Set to true only when running behind a reverse proxy you control that sets
# X-Forwarded-For / X-Forwarded-Proto (used for HTTPS detection and rate limiting).
TRUST_PROXY_HEADERS=false

# --- Email (any SMTP server) --------------------------------------------------
# Leave MAIL_HOST empty to disable outgoing email.
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS), ssl (SMTPS) or none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Hacker Experience"

# --- Optional external services ---------------------------------------------
# Link to an external forum (the bundled phpBB was removed).
FORUM_URL=
# Prefix for in-game help links; page ids such as en:clans are appended.
WIKI_URL=wiki/doku.php?id=
# The in-game bitcoin price follows this real BTC/USD price feed (cached hourly).
# Leave empty to use a fixed price and make no outgoing requests.
BTC_PRICE_URL=https://blockchain.info/q/24hrprice

# --- Python helper scripts ---------------------------------------------------
PYTHON_BIN=python3
# Optional log file for output of the Python scripts started by the game.
PYTHON_LOG=

# --- Backups (scripts/backup.sh) ---------------------------------------------
# BACKUP_DIR=/var/backups/hackerexperience
# BACKUP_KEEP_DAYS=14
# Upload with the AWS CLI when set, e.g. s3://my-bucket/game
# BACKUP_S3_URI=
